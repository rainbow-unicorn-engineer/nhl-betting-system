<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE: the morning run, `python pipeline.py daily` (full 3-credit odds
  snapshot; the day's picks are issued and locked at its prices).

  Replace __REPO__ with the repo's absolute path and __PYTHON__ with the
  virtual environment's Python (usually __REPO__/.venv/bin/python), then
  install it as ops/launchd/README.md describes. Nothing installs this file
  automatically, and the live Mac's existing
  ~/Library/LaunchAgents/com.nhlbetting.daily.plist is NOT replaced.

  The time is this Mac's local time: 9:00 suits a Mac on Central time.
  Adjust it to your zone.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nhlbetting.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__REPO__/pipeline.py</string>
        <string>daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- The logs/ folder must exist before the job first runs; git ignores it -->
    <key>StandardOutPath</key>
    <string>__REPO__/logs/daily.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/daily.log</string>
</dict>
</plist>
