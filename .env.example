# NHL Betting System Configuration
# Copy to .env and fill in values

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nhl_betting
POSTGRES_USER=nhl
POSTGRES_PASSWORD=nhl_dev_2026

# The Odds API (https://the-odds-api.com — free plan: 500 credits a month per key).
# Each machine has its own .env, so each machine can use its own key
ODDS_API_KEY=your_key_here

# System
LOG_LEVEL=INFO
# MoneyPuck download cache. A relative path is relative to the repo, not the current folder
DATA_DIR=./data

# Optional. Remove the leading # to use one.
# Your time zone (IANA name); decides "today" for the slate, the schedule window and the season. Unset = this machine's zone
# LOCAL_TIMEZONE=America/Chicago
# Odds API bookmaker keys you can bet at; only these can supply a pick's price (fair odds still use every book). Unset = every book
# BETTABLE_BOOKS=draftkings,fanduel
# Pin the season; unset = the season containing today's local date, rolling over on July 1. Only for a playoff run past July 1
# NHL_SEASON=20252026
# First season `python pipeline.py backfill` loads (default 20202021); it loads through the current season
# BACKFILL_FIRST_SEASON=20202021
