# NHL Betting System Configuration
# Copy to .env and fill in values

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nhl_betting
POSTGRES_USER=nhl
POSTGRES_PASSWORD=nhl_dev_2026

# The Odds API (https://the-odds-api.com — free plan: 500 credits a month per key).
# Each machine has its own .env and its own key: the picks machine (the Mac) spends
# its key on moneyline snapshots and closes, the props machine (the PC) on player props
ODDS_API_KEY=your_key_here

# System
LOG_LEVEL=INFO
# MoneyPuck download cache. A relative path is relative to the repo, not the current folder
DATA_DIR=./data

# Optional. Remove the leading # to use one.
# Your time zone (IANA name); decides "today" for the slate, the schedule window and the season. Unset = this machine's zone
# LOCAL_TIMEZONE=America/Chicago
# Odds API bookmaker keys you can bet at; only these can supply a pick's price (fair odds still use every book). Unset = every
# book in ODDS_BOOKMAKERS, exchanges included, whose prices leave out their trading fees. Kalshi and Polymarket for a Texas bettor:
# BETTABLE_BOOKS=kalshi,polymarket
# The bet ledger (dashboard My bets tab): labels for the bettors, comma-separated. Use labels, not real names
# BETTORS=bettor 1,bettor 2
# Each bettor's Odds API book keys, numbered in BETTORS order from 1. The Today tab marks the best price at each
# bettor's books. Unset = BETTABLE_BOOKS, else every book. They don't change the picks (those use BETTABLE_BOOKS)
# BETTOR_1_BOOKS=kalshi,polymarket
# BETTOR_2_BOOKS=
# Platform names the My bets tab lists first (any other name can be typed in)
# PLATFORMS=
# Pin the season; unset = the season containing today's local date, rolling over on July 1. Only for a playoff run past July 1
# NHL_SEASON=20252026
# First season `python pipeline.py backfill` loads (default 20202021); it loads through the current season
# BACKFILL_FIRST_SEASON=20202021

# Odds API books for moneyline/puck line/totals snapshots, comma-separated keys from any region. Up to 10 books bill as
# one region: 3 credits a full snapshot, 1 a close. 11 to 20 bill as two (a warning is logged). Unset = these ten:
# ODDS_BOOKMAKERS=kalshi,polymarket,pinnacle,draftkings,fanduel,betmgm,betrivers,espnbet,hardrockbet,novig
# Set ODDS_BOOKMAKERS= (empty) to request whole regions instead; then ODDS_REGIONS applies (us,us2 = 6 credits a full snapshot, 2 a close)
# ODDS_REGIONS=us,us2
# close --due snapshots only when a game starts within this many minutes (default 16)...
# CLOSE_LEAD_MINUTES=16
# ...and no moneyline snapshot is younger than this many minutes (default 16)
# CLOSE_MIN_GAP_MINUTES=16

# Stake limits, each a share of BANKROLL above 0 and at most 1 (a bad value logs an error and the default is used).
# The dashboard's Today tab shows the ones in use; python -m betting.montecarlo shows what bigger limits do
# The most on one bet (default 0.02 = 2%)
# MAX_STAKE_PCT=0.02
# The most on all of one day's picks (default 0.10 = 10%)
# MAX_DAILY_PCT=0.10
# Per-game limits on the picks, counting every market (SKIPPED and voided picks don't count)
# At most this many bets on one game (a whole number, 1 or more; default 3)
# MAX_BETS_PER_GAME=3
# Total stake on one game as a share of BANKROLL (above 0, at most 1; default 0.04 = 4%)
# MAX_GAME_STAKE_PCT=0.04

# The NHL's free odds feed (pipeline.py nhl-odds; the odds and close runs take one too): feed book names left out,
# comma-separated, lower case. Default veikkaus (its favourite often contradicts every other book). Empty keeps every book
# NHL_FEED_EXCLUDE_BOOKS=veikkaus

# Player props (the props machine: pipeline.py props and props --due). Comma-separated Odds API prop markets;
# each costs 1 credit a game per snapshot. One market fits the free 500 a month; four need the paid plan
# PROPS_MARKETS=player_shots_on_goal
# Books for props, as for ODDS_BOOKMAKERS (unset = the same ten); set PROPS_BOOKMAKERS= (empty) to use PROPS_REGIONS
# PROPS_BOOKMAKERS=kalshi,polymarket,pinnacle,draftkings,fanduel,betmgm,betrivers,espnbet,hardrockbet,novig
# PROPS_REGIONS=us
# props --due snapshots a game when it starts within this many minutes (default 16)...
# PROPS_CLOSE_LEAD_MINUTES=16
# ...and it has no prop snapshot younger than this many minutes (default 16; 0 allowed)
# PROPS_CLOSE_MIN_GAP_MINUTES=16

# The news monitor (pipeline.py news --due, every 15 minutes; no Odds API request). It works on game days
# from this local hour until the last puck drop (default 8). News never leads to a pick before that day's daily
# run has finished (its data is not loaded yet), so an hour earlier than the daily run only records news
# NEWS_START_HOUR=8
# A run is skipped when the last one started less than this many minutes ago (default 14)
# NEWS_MIN_GAP_MINUTES=14
# After starter news, a book's fair chance moving this many percentage points or more since the last paid odds
# snapshot means the market already reacted: no new pick from that news (default 1.0)
# NEWS_MOVE_PTS=1.0
# Daily Faceoff line combinations (ingestion/dailyfaceoff_lines.py): a team's page is fetched at most every
# LINEUPS_MIN_GAP_MINUTES (default 29; the site's pages come from a cache up to an hour old) near its puck drop,
# every LINEUPS_FAR_GAP_MINUTES (default 55) while puck drop is more than LINEUPS_NEAR_HOURS (default 3) away,
# with LINEUPS_PAUSE_SECONDS (default 2) between teams. When the site refuses a request (HTTP 429 or 403) the run
# stops asking, and no request goes out for LINEUPS_REFUSED_BACKOFF_MINUTES (default 60) or the site's Retry-After
# LINEUPS_MIN_GAP_MINUTES=29
# LINEUPS_FAR_GAP_MINUTES=55
# LINEUPS_NEAR_HOURS=3
# LINEUPS_PAUSE_SECONDS=2
# LINEUPS_REFUSED_BACKOFF_MINUTES=60
